              "allowBlank": true,
              "regex": {
                "expr": "/^[A-Za-z0-9_:-]*$/",
                "errorText": "Cle invalide : lettres, chiffres, '-', '_' et ':' uniquement, sans espace."
              }
            }
          }
        ]
      }
