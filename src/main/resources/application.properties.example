spring.application.name=site

# Désactive la persistance des sessions Tomcat entre les redémarrages
server.servlet.session.persistent=false

spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=50MB

spring.profiles.active=${SPRING_PROFILES_ACTIVE:local}

app.upload-dir=${UPLOAD_DIR:uploads}

# Deploiement bleu-vert : fichier local (PAS une route HTTP — voir AgentCleApiFileWriter) dans
# lequel la cle API licence de CETTE installation est ecrite en clair, pour que l'Agent de
# deploiement (Task 5, processus local separe) la lise une fois au demarrage. Ecriture atomique,
# permissions 0600 forcees quand le systeme de fichiers le supporte (POSIX). Absent/vide tant que
# ce serveur n'est pas encore enrole — l'Agent doit traiter "fichier absent" comme "pas encore
# pret", pas une erreur.
#
# OBLIGATOIRE, AUCUNE valeur par defaut (fix round 2 de Task 3) : un chemin devine par defaut
# resoudrait dans l'arbre source en dev, hors de tout .gitignore dedie — si absente/vide,
# AgentCleApiFileWriter logue une ERREUR (une seule fois) et n'ecrit jamais rien.
# Production : chemin ABSOLU hors du depot, ex. /var/lib/site/agent/cle-api-licence.
# Dev local : un chemin sous secrets/ (deja ignore par git ci-dessus) convient.
app.agent.cle-api-file-path=${AGENT_CLE_API_FILE_PATH:secrets/agent-cle-api-licence}

# Deploiement bleu-vert : port HTTP local sur lequel l'Agent de deploiement (Task 5, processus
# distinct sur CHAQUE serveur enrole) expose sa route de reveil (POST /reveil, sans corps) — c'est
# CE port que DeploiementScheduler (cote MAITRE) utilise pour contacter l'Agent de chaque
# LicenceServeur ACTIF a chaque nouvelle version detectee sur GitHub. 8090 est un port conventionnel
# en attendant que l'Agent (Task 5) soit construit ; a ajuster si un conflit de port apparait.
app.agent.port=${AGENT_PORT:8090}

# Deploiement bleu-vert (cote MAITRE uniquement, DeploiementScheduler) : depot GitHub (owner/repo)
# dont les tags sont sondes pour detecter une nouvelle version a deployer.
#
# OBLIGATOIRE, AUCUNE valeur par defaut devinee : aucun depot GitHub n'est configure ailleurs dans
# ce projet (pas d'URL github.com existante, pas de <scm> dans pom.xml) — deviner un
# proprietaire/depot par defaut sonderait silencieusement le mauvais depot. Si absente/vide,
# GitHubReleaseClient logue une ERREUR (une seule fois) et ne detecte jamais aucune version.
# Pas d'authentification necessaire (depot aux tags publics, l'image Docker l'est deja).
app.deploiement.github-repo=${DEPLOIEMENT_GITHUB_REPO:}

# Deploiement bleu-vert : intervalle entre deux sondages GitHub par DeploiementScheduler. Defaut
# 5 minutes — volontairement plus large que app.licence.poll-interval-ms (5s) : l'API GitHub non
# authentifiee est limitee a 60 requetes/heure par IP, un sondage trop frequent epuiserait ce quota.
app.deploiement.intervalle-verification-ms=${DEPLOIEMENT_INTERVALLE_VERIFICATION_MS:300000}

# Angular intranet — redirect après OAuth2 SSO
# Dev  : http://localhost:4200/login  (proxy dev server, valeur par défaut dans le code)
# Prod : /app/login                  (JAR embarqué, même domaine)
app.angular.login-redirect=${ANGULAR_LOGIN_REDIRECT:/app/login}

# Mindee OCR — https://platform.mindee.com/
mindee.api-key=${MINDEE_API_KEY:CHANGEME}

# Google Document AI — https://cloud.google.com/document-ai
# Créer un processeur "Invoice Parser" dans la console GCP
google.document-ai.project-id=${GOOGLE_DOCAI_PROJECT_ID:}
google.document-ai.location=${GOOGLE_DOCAI_LOCATION:eu}
google.document-ai.processor-id=${GOOGLE_DOCAI_PROCESSOR_ID:}
# Chemin vers le fichier JSON du compte de service (ou vide pour Application Default Credentials)
google.document-ai.credentials-path=${GOOGLE_DOCAI_CREDENTIALS_PATH:}

# URL simplifiée (on enlève les plugins compliqués car l'utilisateur est standard)

hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.datasource.driver-class-name=org.postgresql.Driver
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect


spring.jpa.properties.hibernate.default_schema=public

spring.jpa.hibernate.ddl-auto=validate
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=1
spring.sql.init.mode=always
# ATTENTION — base neuve/vide : depuis le passage a Flyway (ddl-auto=validate,
# voir plus haut), Hibernate ne cree plus aucune table — V1__baseline.sql est
# vide et ne fait que marquer une base EXISTANTE comme deja a jour. Sur une
# base reellement neuve (ex. futur nouveau noeud client), ni Flyway ni
# Hibernate ne cree encore le schema que ces scripts spring.sql.init
# referencent (requests, admin_modules, ...) : la creation du schema pour
# une base neuve reste a traiter par une migration Flyway dediee (hors
# perimetre de ce chantier bleu-vert, qui cible la base partagee deja
# provisionnee du NAS/dev).
spring.sql.init.schema-locations=classpath:admin-modules-migration.sql,classpath:sync-id-backfill-migration.sql
spring.jpa.show-sql=true
spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.CamelCaseToUnderscoresNamingStrategy
# Chiffrement AES des données sensibles en base
# En production : surcharger via variables d'environnement APP_CRYPTO_KEY / APP_CRYPTO_SALT
# La clé doit faire ≥ 8 caractères ; le salt doit être une chaîne hex de longueur paire (ex: 16 hex = 8 octets)
app.crypto.key=${APP_CRYPTO_KEY:changeme-dev-key-32chars!!}
app.crypto.salt=${APP_CRYPTO_SALT:deadbeefdeadbeef}

spring.security.user.name=admin
spring.security.user.password=CHANGEME

# Controle de sante (deploiement bleu-vert) : surface minimale, seul /actuator/health est expose.
management.endpoints.web.exposure.include=health



# OAuth2 redirect base URL (override en prod)
app.oauth.redirect-base=${APP_OAUTH_REDIRECT_BASE:http://localhost:8080}

# Reverse proxy / SSL termination — fait confiance aux headers X-Forwarded-Proto/Host
# Indispensable pour que les redirects OAuth2 génèrent https:// en prod
server.forward-headers-strategy=native

# Boutique — valeurs par défaut (surchargées en base via /intra/shop/settings et /intra/payment/*)
shop.name=${SHOP_NAME:Notre Boutique}
shop.base-url=${SHOP_BASE_URL:http://localhost:8080}

# Ingram Micro — URL de base (sandbox = même URL, credentials sandbox différents)
# Production  : https://api.ingrammicro.com:443
# Test        : utiliser des credentials sandbox fournis par le portail Ingram
ingram.base-url=${INGRAM_BASE_URL:https://api.ingrammicro.com:443}

# Désactive le cache Thymeleaf en mode dev
spring.thymeleaf.cache=false
# Active le redémarrage automatique des DevTools
spring.devtools.restart.enabled=true
# Surveille les changements dans les dossiers de ressources
spring.devtools.restart.additional-paths=src/main/resources

# JWT — Mobile REST API
app.jwt.secret=${APP_JWT_SECRET:CHANGEME-min-32-bytes}
app.jwt.expiration=${APP_JWT_EXPIRATION:86400000}

# ── Social Login OAuth2 ────────────────────────────────────────────────────────
# Les credentials sont lus dynamiquement depuis les MailAccount configurés en base.
# Aucune configuration supplémentaire requise ici.

# ── Cloudflare Turnstile (anti-bot) ───────────────────────────────────────────
# Créer une site sur https://dash.cloudflare.com/?to=/:account/turnstile
# Mettre captcha.enabled=true en production et définir les deux clés
captcha.enabled=${CAPTCHA_ENABLED:true}
captcha.site-key=${TURNSTILE_SITE_KEY:CHANGEME}
captcha.secret-key=${TURNSTILE_SECRET_KEY:CHANGEME}

# ── Gemini AI (chat bot + résumé) ──────────────────────────────────────────────
gemini.api-key=${GEMINI_API_KEY:CHANGEME}

# ── Plateforme de plugins (voir docs/plateforme-plugins-local.md) ─────────────
# Desactivee par defaut : sans app.plateforme.actif=true, aucun bean, aucune route
# /api/plateforme/** ni /api/plugins/** n'est servie (le coeur se comporte comme avant).
app.plateforme.actif=${PLATEFORME_ACTIF:false}
# Repertoire des jars de plugins (relatif au repertoire de lancement, ou absolu). Chaque .jar
# y est installe au demarrage ; un sous-dossier .work/ y recoit les copies chargees.
app.plateforme.repertoire-plugins=${PLATEFORME_REPERTOIRE_PLUGINS:plugins}
# Delai maximal de drainage des requetes en vol avant fermeture d'une version (ms).
app.plateforme.delai-drainage-ms=${PLATEFORME_DELAI_DRAINAGE_MS:30000}
# Version du coeur, comparee aux bornes coeur-min / coeur-max des manifestes de plugin.
app.plateforme.version-coeur=${PLATEFORME_VERSION_COEUR:0.0.0}
# Purge des caches qui retiennent une version retiree. TOUJOURS true en production
# (false ne sert qu'au test qui prouve que la mesure de fuite detecte une fuite).
app.plateforme.nettoyage-actif=true
# Autorise GET /api/plateforme/fuites?pression=true a remplir le tas jusqu'a OutOfMemoryError
# (mesure exacte). Brutal pour les autres threads : diagnostic/tests uniquement, false en production.
app.plateforme.diagnostic-fuites=false
